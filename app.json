{
  "expo": {
    "name": "AnytimeFitenss",
    "slug": "anytimefitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anytimefitenss",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0F",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shuvojsdev.AnytimeFitenss"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0F",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#0C0C0F"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3aaf583-142b-4d3b-8cc6-afde6a13f551"
      }
    },
    "owner": "shuvojsdev"
  }
}
